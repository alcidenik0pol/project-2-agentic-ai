# Reddit Public API Configuration
# No authentication required - we use Reddit's public JSON API
# Optional: Set a custom user agent (defaults to complaint-analyzer:1.0)
# REDDIT_USER_AGENT=script:your_app_name:1.0 (by /u/your_reddit_username)

# LLM Provider Selection
# Options: "gcloud" (default) or "lm_studio"
LLM_PROVIDER=gcloud

# LM Studio Configuration (for local LLM classification)
# Only used when LLM_PROVIDER=lm_studio
# LM_STUDIO_BASE_URL=http://localhost:1234/v1
# LM_STUDIO_MODEL=qwen3.5-27b-claude-4.6-opus-reasoning-distilled
# LM_STUDIO_TIMEOUT=30
# LM_STUDIO_MAX_RETRIES=3

# Google Cloud Vertex AI Configuration
# Only used when LLM_PROVIDER=gcloud (default)
GCLOUD_PROJECT=AgenticAIColumbia
GCLOUD_REGION=us-central1
GCLOUD_MODEL=gemini-2.5-flash-001
# Path to service account JSON key file (required for gcloud)
# Download from Google Cloud Console > IAM & Admin > Service Accounts
# IMPORTANT: Add this file to .gitignore!
GCLOUD_SERVICE_ACCOUNT_KEY_PATH=/path/to/your/service-account-key.json
GCLOUD_TIMEOUT=30
GCLOUD_MAX_RETRIES=3
