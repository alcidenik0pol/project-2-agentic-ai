*.py[cod]
*.pyo
*$py.class
*.egg-info/
dist/
build/
*.egg
.pytest_cache/

# Virtual environments
venv/
.env/
.venv/

# Large data files
*.csv
*.xlsx
*.xls
*.parquet
*.sqlite
*.db
*.pkl
*.pickle
*.h5
*.hdf5

# Archives and binaries
*.zip
*.tar
*.tar.gz
*.rar
*.7z
*.exe
*.dll
*.so
*.dylib

# Media files
*.mp4
*.mp3
*.wav
*.avi
*.mov
*.wmv
*.flac
*.ogg
*.webm

# Images
*.png
*.jpg
*.jpeg
*.gif
*.bmp
*.tiff
*.ico
*.svg
*.webp

# Fonts
*.ttf
*.otf
*.woff
*.woff2

# Documents (non-md)
*.pdf
*.doc
*.docx
*.ppt
*.pptx

# Jupyter
.ipynb_checkpoints/

# IDE
.vscode/
.idea/
*.swp
*.swo
*~

# OS
.DS_Store
Thumbs.db
desktop.ini
nul

# Environment and secrets
.env
.env.*
!.env.example

# Credentials
docs/credentials/

# Logs
*.log

# Docker
docker-compose.override.yml
.docker/

# Frontend
frontend/node_modules/
frontend/.next/
frontend/out/
frontend/.firebase/

# Allow JSON and Markdown (but NOT credentials)
!*.json
!*.md

# Local data, caches, and runtime artifacts — never track
# Must come AFTER !*.json above so the un-ignore rule doesn't re-include them
data/
output/
